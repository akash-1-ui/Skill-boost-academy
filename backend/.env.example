# ============================================
# DATABASE CONFIGURATION (MySQL)
# ============================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=course_registration
# Or use a MySQL connection string instead:
# DATABASE_URL=mysql://user:password@host:3306/database_name
# Or enable MongoDB mode for the academy/admin access portal:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/skill_boost_nexus?retryWrites=true&w=majority
# MONGODB_DB=skill_boost_nexus

# ============================================
# CLOUDINARY CONFIGURATION
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_VIDEO_FOLDER=skillboost/courses

# ============================================
# EMAIL/SMTP CONFIGURATION
# ============================================
# Option 1: Using Email Service (Gmail, Yahoo, etc.)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Option 2: Using Custom SMTP Server (uncomment if using)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false

# ============================================
# JWT/SECURITY CONFIGURATION
# ============================================
ACCESS_OWNER_JWT_SECRET=your_access_owner_secret_key_here
PASSWORD_RESET_JWT_SECRET=your_password_reset_secret_key_here

# ============================================
# OTP CONFIGURATION
# ============================================
RESET_OTP_EXPIRY_MINUTES=2
RESET_OTP_RESEND_SECONDS=120
RESET_OTP_MAX_ATTEMPTS=5

# ============================================
# PAYMENT GATEWAY (Razorpay)
# ============================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000

# ============================================
# DATABASE URL (Optional, for cloud databases)
# ============================================
# DATABASE_URL=your_database_url_if_using_cloud
